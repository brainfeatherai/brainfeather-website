{
  "name": "brainfeather-website",
  "version": "0.1.0",
  "description": "Brainfeather — long-term memory for AI coding agents.",
  "homepage": "https://brainfeather.com",
  "author": "Brainfeather",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainfeatherai/brainfeather-website.git"
  },
  "//": "private + UNLICENSED: proprietary. `private` also blocks an accidental `npm publish`. See LICENSE.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "//test": "Glob, not a hand-listed manifest: an unlisted new test file was silently never run, and CI could not notice.",
    "test": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test \"src/**/*.test.ts\"",
    "schema:memory-candidates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --env-file=.env.local scripts/ensure-memory-candidates.ts",
    "schema:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --env-file=.env.local scripts/migrate-appwrite-schema.ts",
    "schema:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --env-file=.env.local scripts/verify-appwrite-schema.ts",
    "eval:retrieval": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/evaluate-retrieval.ts",
    "bench:repo-memory": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/repomembench.ts",
    "mcp:server-card": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/generate-server-card.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sentry/nextjs": "^10.71.0",
    "appwrite": "^26.2.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.3",
    "node-appwrite": "^28.0.0",
    "nodemailer": "9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "qs": "6.16.0"
  },
  "onlyBuiltDependencies": [
    "@sentry/cli",
    "sharp",
    "unrs-resolver"
  ]
}
