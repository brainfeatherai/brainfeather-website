# Appwrite
# NOTE: nothing in the site imports these yet — src/services/appwrite.ts is
# not wired to any page. The DATABASE_ID line was missing from this file
# while the code already read it, so wiring it up would have failed at
# runtime with an undefined database.
#
# REGION: the endpoint host is region-specific, and each region is an
# independent cluster — so this must match the region you picked when
# creating the project, or every call 404s.
#   Singapore     https://sgp.cloud.appwrite.io/v1   <- closest live region to India
#   Frankfurt     https://fra.cloud.appwrite.io/v1
#   Sydney        https://syd.cloud.appwrite.io/v1
#   New York      https://nyc.cloud.appwrite.io/v1
#   San Francisco https://sfo.cloud.appwrite.io/v1
#   Toronto       https://tor.cloud.appwrite.io/v1
# Bangalore (BLR) is announced but not yet available — no ETA.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
APPWRITE_API_KEY=your-api-key

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key

# Pinecone (for vector search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=brainfeather

# Waitlist → Google Sheet
# The /exec URL of the Apps Script Web App in scripts/waitlist-sheet.gs.
# SERVER-ONLY — never prefix this with NEXT_PUBLIC_, or the browser
# receives it and anyone can append rows to your sheet.
WAITLIST_WEBHOOK_URL=
# Optional. Must match SHARED_SECRET in the Apps Script.
WAITLIST_WEBHOOK_SECRET=
