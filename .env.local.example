# Appwrite
# NOTE: src/services/appwrite.ts covers client auth only; all application
# data goes through authenticated server routes using the admin SDK.
#
# REGION: the endpoint host is region-specific, and each region is an
# independent cluster — so this must match the region you picked when
# creating the project, or every call 404s.
#   Singapore     https://sgp.cloud.appwrite.io/v1   <- closest live region to India
#   Frankfurt     https://fra.cloud.appwrite.io/v1
#   Sydney        https://syd.cloud.appwrite.io/v1
#   New York      https://nyc.cloud.appwrite.io/v1
#   San Francisco https://sfo.cloud.appwrite.io/v1
#   Toronto       https://tor.cloud.appwrite.io/v1
# Bangalore (BLR) is announced but not yet available — no ETA.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id
APPWRITE_API_KEY=your-api-key

# Server-only HMAC secret for agent session tokens. Generate at least 32 random bytes.
# Falls back to BRAINFEATHER_DATA_INDEX_KEY during encrypted-data rollouts.
BRAINFEATHER_SESSION_SECRET=

# ── Data encryption & storage modes ───────────────────────────────
# See README §"User data encryption rollout" and §"API key storage
# rollout" for the full procedures. Modes:
#   plaintext      keyless development default; reads/writes plaintext
#   compatibility  reads plaintext + ciphertext, writes plaintext; keys required
#   encrypted      writes ciphertext, blind-indexes private identifiers
# Production requires encrypted plus explicit keys and refuses to boot
# otherwise (production-config.ts).
BRAINFEATHER_DATA_ENCRYPTION=
# keyId:base64url(32 bytes), comma-separated, newest first. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BRAINFEATHER_DATA_ENCRYPTION_KEYS=
# Independent 32-byte key for tenant-bound blind indexes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it requires a coordinated index migration — see README.
BRAINFEATHER_DATA_INDEX_KEY=
# hashed | compatibility. Production requires hashed (or compatibility
# during the staged rollout described in the README).
BRAINFEATHER_API_KEY_STORAGE=

# Public endpoint throttling
# HMAC secret for the anonymous waitlist + registration rate-limit buckets
# (src/lib/server/public-rate-limit.ts). Only an HMAC bucket is stored —
# never the raw network address. Generate at least 32 random bytes.
# Production validates it at boot.
BRAINFEATHER_RATE_LIMIT_SECRET=

# Waitlist email delivery
# 16-character Google app password for getbrainfeather@gmail.com (NOT the
# Gmail account password). Requires 2-step verification on the account.
# See README §"Waitlist email notifications". Rotating it requires a redeploy.
GMAIL_APP_PASSWORD=

# Waitlist approval links
# Signs the expiring /approve review links emailed for each waitlist request
# (src/lib/server/waitlist-approval.ts). New links use only this dedicated
# secret. Links created before the migration can verify with APPWRITE_API_KEY
# only through 2026-10-31, after which that compatibility path self-retires.
# Generate at least 32 random bytes, and set it in Vercel too. Production validates it via
# production-config.ts at boot.
WAITLIST_APPROVAL_SECRET=

# Sentry (error tracking)
# All optional — every Sentry init is a no-op until the DSN exists.
#   DSN:          safe to expose (write-only). Sentry → project → Client Keys.
#   AUTH_TOKEN:   SERVER-ONLY, build time. Uploads source maps so stack
#                 traces are readable. Sentry → Settings → Auth Tokens
#                 (org:read + project:releases scopes). Never commit it.
#   ORG/PROJECT:  slugs from the Sentry project settings page.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
